# Log file to protect (e.g. /var/log/auth.log). Defaults to ~/log_project/source.log
LOGSEC_SOURCE_LOG=~/log_project/source.log
# Copy to .env (never commit .env) or export these in your shell.
# Use a Gmail App Password, not your normal Gmail password.
LOGSEC_EMAIL_SENDER=you@gmail.com
LOGSEC_EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
LOGSEC_EMAIL_RECEIVER=you@gmail.com
